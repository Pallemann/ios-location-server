# Copy to .env and keep it private (chmod 600).
TZ=UTC

# The phone's Wi-Fi IP. Give it a DHCP reservation in your router and set
# Settings > Wi-Fi > (i) > Private Wi-Fi Address = Fixed on the phone.
PHONE_IP=192.168.1.50

# Host port for the web UI (bound to 127.0.0.1 only).
PORT=8000

# The service switches itself off after this many minutes without a connection.
IDLE_TIMEOUT_MINUTES=60

# Optional Live Activity via Home Assistant (docker-compose.ha.yml). Leave empty to disable.
# HA_NOTIFY is the notify service without "notify.", e.g. mobile_app_my_iphone
HA_TOKEN=
HA_NOTIFY=
HA_PORT=8124
